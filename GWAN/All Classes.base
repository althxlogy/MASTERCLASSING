views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder.contains("GWAN")
    order:
      - file.folder
      - file.name
      - file.tags
    sort:
      - property: file.folder
        direction: DESC
      - property: file.tags
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.folder: 445
  - type: cards
    name: View
